# Пароль для режима менеджера (вход на /manager)
MANAGER_PASSWORD=change-me

# Секрет для подписи cookie сессии менеджера. Любая длинная случайная строка.
SESSION_SECRET=please-generate-a-long-random-string

# Где хранить сохранённые расчёты. По умолчанию — папка .data/quotes в корне проекта.
# QUOTES_DIR=/var/lib/zhk-tv/quotes
