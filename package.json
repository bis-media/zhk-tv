{
  "name": "zhk-tv",
  "version": "1.0.0",
  "private": true,
  "description": "B2B-калькулятор рекламы на умных экранах в жилых комплексах",
  "scripts": {
    "fetch:data": "node scripts/fetch-source.mjs",
    "build:data": "node scripts/build-dataset.mjs",
    "dev": "next dev",
    "build": "npm run build:data && next build",
    "build:static": "node scripts/build-static.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "next": "15.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "typescript": "5.7.2"
  }
}
